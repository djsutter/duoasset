APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Alpha Vantage market data (free tier: 25 req/day; quotes cached 24h)
ALPHA_VANTAGE_KEY=

# Earnings surprise scanner (Financial Modeling Prep)
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
MARKET_DATA_PROVIDER=fmp
EARNINGS_SCANNER_ENABLED=true
EARNINGS_SCANNER_MIN_MARKET_CAP=100000000
EARNINGS_SCANNER_MIN_EPS_SURPRISE_PERCENT=90
EARNINGS_SCANNER_NOTIFICATION_EMAIL=

# EPS Earnings Surprise (bidirectional)
EPS_EARNINGS_POSITIVE_THRESHOLD=90
EPS_EARNINGS_NEGATIVE_THRESHOLD=-30

# EPS Revision (analyst estimate change before earnings)
EPS_REVISION_SCANNER_ENABLED=true
EPS_REVISION_POSITIVE_THRESHOLD=20
EPS_REVISION_NEGATIVE_THRESHOLD=-20
EPS_REVISION_MIN_MARKET_CAP=100000000
EPS_REVISION_MAX_SYMBOLS=2000

BUY_SETUP_SCANNER_ENABLED=true
BUY_SETUP_MIN_MARKET_CAP=100000000
BUY_SETUP_MAX_SYMBOLS=4000
BUY_SETUP_EXCHANGES=NYSE,NASDAQ,TSX,TSXV,AMEX,OTC
BUY_SETUP_HISTORY_LOOKBACK_DAYS=504
BUY_SETUP_MIN_HEARTBEAT_SCORE=50
BUY_SETUP_BENCHMARK_SYMBOLS=SPY,IWM

# Stock Buy Setup scanner
# Setup score ranks candidates within the detected setup type. Heartbeat is the consolidation/plateau component.
# BUY_SETUP_MIN_SETUP_SCORE is a UI default/filter only. Scanner saves every detector match.
# BUY_SETUP_NOTIFY_MIN_SETUP_SCORE controls email/watchlist propagation for created matches.
BUY_SETUP_MIN_SETUP_SCORE=0
BUY_SETUP_NOTIFY_MIN_SETUP_SCORE=50
BUY_SETUP_TYPE_HEARTBEAT_CONSOLIDATION_SPIKE_ENABLED=true
BUY_SETUP_TYPE_RANGE_COMPRESSION_BREAKOUT_ENABLED=false
BUY_SETUP_TYPE_FLOOR_REVERSAL_ACCUMULATION_ENABLED=false
BUY_SETUP_TYPE_EARLY_BREAKOUT_FOLLOWTHROUGH_ENABLED=false

BUY_SETUP_RECENT_SPIKE_WINDOW_DAYS=42
BUY_SETUP_SPIKE_LOOKBACK_DAYS=84
BUY_SETUP_MIN_BASE_DAYS=60
BUY_SETUP_MAX_BASE_DAYS=120
BUY_SETUP_MAX_RANGE_COMPRESSION_PCT=25
BUY_SETUP_MAX_ATR_RATIO=0.85

# Sleepy-volume penalty uses average daily volume / float shares (or shares outstanding).
# These values are max percent penalties by market-cap bucket.
BUY_SETUP_SLEEPY_VOLUME_LARGE_CAP_PENALTY_PCT=40
BUY_SETUP_SLEEPY_VOLUME_MEDIUM_CAP_PENALTY_PCT=30
BUY_SETUP_SLEEPY_VOLUME_SMALL_CAP_PENALTY_PCT=20
BUY_SETUP_SLEEPY_VOLUME_MICRO_CAP_PENALTY_PCT=15

BUY_SETUP_NOTIFICATION_EMAIL=

# Current heartbeat-consolidation-spike score component weights.
# These are point weights, not hard filters on the raw values.
# The raw sum is normalized to a 0-100 setup score.
BUY_SETUP_SCORE_SPIKE_RARITY_WEIGHT=25
BUY_SETUP_SCORE_BASE_DURATION_WEIGHT=10
BUY_SETUP_SCORE_RANGE_COMPRESSION_WEIGHT=15
BUY_SETUP_SCORE_ATR_CONTRACTION_WEIGHT=10
BUY_SETUP_SCORE_VOLUME_DRY_UP_WEIGHT=10
BUY_SETUP_SCORE_BREAKOUT_DISTANCE_WEIGHT=10
BUY_SETUP_SCORE_MA_ALIGNMENT_WEIGHT=10
BUY_SETUP_SCORE_RELATIVE_STRENGTH_WEIGHT=10
BUY_SETUP_SCORE_EARNINGS_ACCELERATION_WEIGHT=5
BUY_SETUP_SCORE_SALES_ACCELERATION_WEIGHT=5

# Positive EPS and sales acceleration are scored on a smooth logarithmic curve.
# Each scale is the raw acceleration value (percentage-point change) that earns
# the component's full configured weight. Larger values remain capped at max.
BUY_SETUP_EPS_ACCELERATION_SCALE=75
BUY_SETUP_SALES_ACCELERATION_SCALE=100
